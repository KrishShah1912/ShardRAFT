{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./.test-build",
    "incremental": false
  },
  "include": [
    "src/api/routing.ts",
    "src/api/client.ts",
    "src/api/multiRaft.ts",
    "src/api/multiDiagnostics.ts",
    "src/multi/clusterState.ts",
    "src/validation/report.ts",
    "src/validation/types.ts",
    "src/api/multiGateway.ts",
    "src/multi/keyRouting.ts",
    "src/multi/pendingMutation.ts",
    "src/multi/liveTelemetry.ts",
    "src/multi/liveEventStream.ts",
    "src/multi/useMultiLiveTelemetry.ts",
    "src/multi/electionTelemetry.ts",
    "src/multi/replicationTelemetry.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".test-build"
  ]
}
